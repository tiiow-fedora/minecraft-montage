[
  "ffmpeg",
  "-y",
  "-hide_banner",
  "-loglevel",
  "error",
  "-stats",
  "-i",
  "<TMP>/clips/a.mp4",
  "-i",
  "<TMP>/clips/b.mp4",
  "-filter_complex",
  "[0:v]scale=1920:1080:force_original_aspect_ratio=decrease,pad=1920:1080:(ow-iw)/2:(oh-ih)/2,fps=60,format=yuv420p,setsar=1[v0];[1:v]scale=1920:1080:force_original_aspect_ratio=decrease,pad=1920:1080:(ow-iw)/2:(oh-ih)/2,fps=60,format=yuv420p,setsar=1[v1];[v0][v1]xfade=transition=fade:duration=1.0:offset=24.000[x1];[x1]fade=t=in:st=0:d=1.0,fade=t=out:st=41.500:d=2.5[vout]",
  "-map",
  "[vout]",
  "-an",
  "-c:v",
  "libx264",
  "-preset",
  "medium",
  "-crf",
  "18",
  "-pix_fmt",
  "yuv420p",
  "-movflags",
  "+faststart",
  "-t",
  "44.000",
  "<TMP>/out/final.mp4"
]
